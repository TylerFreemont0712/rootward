# Copy to .env (git-ignored). Every key is optional; the game runs with none of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local model servers (defaults shown; leave blank to use defaults). llama.cpp is the default local provider.
LLAMACPP_BASE_URL=http://localhost:8080/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434
# API server port for `pnpm dev` / `pnpm start` (default 7331)
ROOTWARD_PORT=
# Where SQLite profiles live (default: ~/.local/share/rootward)
ROOTWARD_DATA_DIR=
# Unsandboxed local-process runner. Leave false unless you understand the risk.
ROOTWARD_ALLOW_PROCESS_RUNNER=false

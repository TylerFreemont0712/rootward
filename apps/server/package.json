{
  "name": "@rootward/server",
  "version": "0.0.0",
  "private": true,
  "description": "Local Fastify host around the core engine, content, and runners.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@rootward/content-schema": "workspace:*",
    "@rootward/content-tools": "workspace:*",
    "@rootward/core": "workspace:*",
    "@rootward/runners": "workspace:*",
    "@rootward/shared": "workspace:*",
    "fastify": "5.12.4",
    "zod": "4.6.4"
  }
}
